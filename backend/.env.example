# Copy to .env and fill in your own values. Never commit .env.
# PostgreSQL (production / docker-compose). For local dev without
# PostgreSQL, leave the SQLite default in config.py.
DATABASE_URL=postgresql+psycopg://agrimart:agrimart@localhost:5432/agrimart

# JWT — generate a long random value, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Manual bKash / Nagad payments (no live gateway).
# Customers pay to these numbers and submit their transaction ID.
BKASH_NUMBER=01736439950
NAGAD_NUMBER=
